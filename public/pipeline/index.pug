extends ./layout
block external_cdn_css
    link(rel='stylesheet', href="/apps/kilroy.utils/lib/bootstrap/5.3.8/css/bootstrap.min.css")
    link(rel="stylesheet", href="/apps/kilroy.utils/lib/jquery-ui/1.12.1/jquery-ui.min.css")

block external_cdn_scripts
    script(src="/apps/kilroy.utils/lib/jquery/3.7.1/jquery.min.js")
    script(src="/apps/kilroy.utils/lib/jquery-ui/1.12.1/jquery-ui.min.js")
    script(src="/apps/kilroy.utils/lib/bootstrap/5.3.8/js/bootstrap.bundle.min.js")
    script(src="/apps/kilroy.utils/lib/gojs/4.0.3/release/go.js")
    
block inline_styles
    style.
        body { background: #2A303D !important; }

block title
    title Telegrm Chat_Agents

block content
    .w-100.container-fluid
        #pd-palettes.w-75.mx-auto
            .card.mt-2.shadow
                .card-header
                    h3 Telegram Chat_Agents
                    p Click and copy individual agents, then paste into Pipeline Editor document.
                    p See "?" Help for details about configuring Telegram bots for use with kilroy.ai.services
                .card-body
                    #pd-palette-area-1.palette-area.bg-white(style="min-height: 240px !important;")

block static_scripts
    script(src="./js/static/LocalStorageCommandHandler.js")

block custom_scripts
    script(src="./js/Figures.js")
    script(src="./js/palette_defs.js")
    script(src="./js/pipeline_palette_impl.js")